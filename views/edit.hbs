<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css"
    />
    <link
      rel="shortcut icon"
      href="/assets/image/dumbways.png"
      type="image/x-icon"
    />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
      crossorigin="anonymous"
    />
    <style>
      .container { width: 70%; padding: 20px 100px; }
      .input-group { display: flex; gap: 1rem; }
      .input-group .form-group { flex: 1; }
      .checkbox-container { display: flex; flex-wrap: wrap; }
      .checkbox-container .form-check { margin-right: 1rem; }
      @media (max-width: 600px) {
        .container { width: 80%; padding: 10px; }
      }
    </style>
    <title>Edit Blog Project</title>
  </head>
  <body>
    <nav
      class="navbar navbar-expand-lg bg-dark-subtle text-dark-emphasis p-3 m-1"
    >
      <div class="container-fluid">
        <img src="/assets/image/dumbways.png" alt="" width="50" />
      </div>
    </nav>
    <div class="container shadow bg-body-tertiary rounded">
      <h1 class="text-center pt-5">Edit My Project</h1>
      <form
        class="p-5"
        id="projectform"
        method="post"
        action="/edit/{{project.id}}"
        enctype="multipart/form-data"
      >
        <div class="mb-3">
          <label for="name" class="form-label">Project Name</label>
          <input type="text" class="form-control" id="name" name="title" value="{{project.title}}" />
        </div>
        <div class="input-group mb-3">
          <div class="form-group">
            <label for="start" class="form-label">Start Date</label>
            <input type="date" class="form-control" id="start" name="start" value="{{project.start}}" />
          </div>
          <div class="form-group">
            <label for="end" class="form-label">End Date</label>
            <input type="date" class="form-control" id="end" name="end" value="{{project.end}}" />
          </div>
        </div>
        <div class="mb-3">
          <label for="message" class="form-label">Description</label>
          <textarea
            class="form-control"
            id="desk"
            rows="10"
            name="desk"
          >{{project.desk}}</textarea>
        </div>
        <div class="mb-3">
  <label for="message" class="form-label">Technologies</label>
  <div class="checkbox-container">
    <div class="row">
      <div class="col-md-6 mb-3">
        <div class="form-check">
          <input
            type="checkbox"
            name="technologies[]"
            value="nodejs"
            class="form-check-input"
            id="node"
            {{#if (includes technologies 'nodejs')}} checked {{/if}}
          />
          <label class="form-check-label" for="node">Node js</label>
        </div>
      </div>
      <div class="col-md-6 mb-3">
        <div class="form-check">
          <input
            type="checkbox"
            name="technologies[]"
            value="react"
            class="form-check-input"
            id="react"
            {{#if (includes technologies 'react')}} checked {{/if}}
          />
          <label class="form-check-label" for="react">React js</label>
        </div>
      </div>
      <div class="col-md-6 mb-3">
        <div class="form-check">
          <input
            type="checkbox"
            name="technologies[]"
            value="nextjs"
            class="form-check-input"
            id="next"
            {{#if (includes technologies 'nextjs')}} checked {{/if}}
          />
          <label class="form-check-label" for="next">Next js</label>
        </div>
      </div>
      <div class="col-md-6 mb-3">
        <div class="form-check">
          <input
            type="checkbox"
            name="technologies[]"
            value="typescript"
            class="form-check-input"
            id="typescript"
            {{#if (includes technologies 'typescript')}} checked {{/if}}
          />
          <label class="form-check-label" for="typescript">TypeScript</label>
        </div>
      </div>
    </div>
  </div>

          <label for="formFile" class="form-label">Upload Image</label>
          <input class="form-control" type="file" id="image" name="image" />
        </div>
        <input type="hidden" name="userId" value="{{userId}}" />
        <button type="submit" class="btn btn-dark float-end" id="submit">Update Project</button>
      </form> 
    </div>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
      integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
      crossorigin="anonymous"
    ></script>
  </body>
</html>




